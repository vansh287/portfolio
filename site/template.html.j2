<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ meta.title|e }}</title>
<meta name="description" content="{{ meta.description|e }}" />
<meta name="author" content="{{ person.name|e }}" />
<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14151a" media="(prefers-color-scheme: dark)" />
<meta name="robots" content="index, follow" />
<script>
{{ head_js }}
</script>
<link rel="canonical" href="{{ meta.url|e }}" />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content="{{ person.name|e }}" />
<meta property="og:title" content="{{ meta.title|e }}" />
<meta property="og:description" content="{{ meta.og_description|e }}" />
<meta property="og:url" content="{{ meta.url|e }}" />
<meta property="og:image" content="{{ meta.og_image|e }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ meta.og_image_alt|e }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ meta.title|e }}" />
<meta name="twitter:description" content="{{ meta.og_description|e }}" />
<meta name="twitter:image" content="{{ meta.og_image|e }}" />

<link rel="preload" href="fonts/gambetta-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />

<script type="application/ld+json">
{{ jsonld }}
</script>

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='16' fill='%231c1b17'/><text x='50' y='68' font-family='Georgia,serif' font-size='54' font-weight='700' fill='%23fbfaf7' text-anchor='middle'>V</text></svg>" />

<style>
{{ css }}
</style>
</head>
<body>

<a class="skip" href="#intro">Skip to content</a>

<!-- ==================== MENU ==================== -->
<div class="chrome">
  <button id="themebtn" type="button" aria-label="Switch to dark theme">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"/>
      <path d="M12 2.4v2.4M12 19.2v2.4M2.4 12h2.4M19.2 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7"/>
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z"/>
    </svg>
  </button>
  <button id="menubtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
    <span></span><span></span><span></span>
  </button>
</div>
<div id="scrim"></div>
<nav id="menu" aria-label="Sections">
{%- for m in menu %}
  <a href="{{ m.href|e }}"><i>{{ m.num|e }}</i>{{ m.label|e }}</a>
{%- endfor %}
  <div class="sep"></div>
  <a class="out" href="{{ person.github|e }}" rel="me noopener"><i>&nearr;</i>GitHub</a>
  <a class="out" href="{{ person.linkedin|e }}" rel="me noopener"><i>&nearr;</i>LinkedIn</a>
</nav>

<main>

<!-- ==================== INTRO ==================== -->
<section id="intro" class="wrap">
  <div class="introgrid">
    <div>
      <p class="kicker">{{ person.kicker|e }}</p>
      <h1>{{ person.name|e }}</h1>
      <p class="role">{{ person.role|e }}</p>

      <div class="prose">
{%- for p in intro.paragraphs_html %}
        <p>{{ p }}</p>
{%- endfor %}
      </div>

      <p class="here"><b>{{ intro.now_label|e }}</b> {{ intro.now_html }}</p>

      <div class="introlinks">
{%- for b in intro.buttons %}
        <a class="btn{% if b.primary %} primary{% endif %}" href="{{ b.href|e }}">{{ b.label|e }}</a>
{%- endfor %}
      </div>
    </div>

    <div class="side">
    <figure class="portrait">
      <picture>
        <source type="image/webp" sizes="(max-width:820px) 230px, (max-width:1180px) 32vw, 340px"
                srcset="img/vansh-340.webp 340w, img/vansh-560.webp 560w, img/vansh-880.webp 880w" />
        <img src="img/vansh-560.jpg"
             srcset="img/vansh-340.jpg 340w, img/vansh-560.jpg 560w, img/vansh-880.jpg 880w"
             sizes="(max-width:820px) 230px, (max-width:1180px) 32vw, 340px"
             width="880" height="1105" alt="{{ person.photo_alt|e }}"
             fetchpriority="high" decoding="async" />
      </picture>
      <figcaption><span>{{ person.photo_caption_left|e }}</span><span>{{ person.photo_caption_right|e }}</span></figcaption>
    </figure>

{%- if updates %}
    <div class="updates reveal">
      <h2>Recent</h2>
      <ul>
{%- for u in updates %}
        <li>
          <span class="d">{{ u.date|e }}</span>
          <p>{{ u.html }}</p>
        </li>
{%- endfor %}
      </ul>
    </div>
{%- endif %}
    </div>
  </div>
</section>

<!-- ==================== INTERESTS ==================== -->
<section class="s wrap" id="interests">
  <div class="shead reveal"><span class="n">{{ num('#interests') }}</span><h2>{{ interests.heading|e }}</h2></div>
  <div class="prose">
    <p>{{ interests.lead_html }}</p>
  </div>
  <div class="tags reveal">
{%- for t in interests.tags %}
    <span>{{ t|e }}</span>
{%- endfor %}
  </div>
</section>

<!-- ==================== PUBLICATION ==================== -->
<section class="s wrap" id="publication">
  <div class="shead reveal"><span class="n">{{ num('#publication') }}</span><h2>{{ publication.heading|e }}</h2></div>

  <article class="paper reveal">
    <p class="venue">{{ publication.venue|e }}</p>
    <h3>{{ publication.title|e }}</h3>
    <p class="authors">{{ publication.authors_html }}</p>
{%- if publication.badge %}
    <p class="badge">{{ publication.badge|e }}</p>
{%- endif %}

    <div class="paperbody">
    <div>
    <div class="prose">
{%- for p in publication.paragraphs_html %}
      <p>{{ p }}</p>
{%- endfor %}
    </div>

    <div class="paperlinks">
{%- for l in publication.links %}
      <a class="btn{% if l.primary %} primary{% endif %}" href="{{ l.href|e }}" rel="noopener">{{ l.label|e }}</a>
{%- endfor %}
    </div>
    </div>

    <aside class="glance">
      <h4>{{ publication.glance_heading|e }}</h4>
      <dl>
{%- for g in publication.glance %}
        <dt>{{ g.label|e }}</dt>
        <dd>{{ g.value_html }}</dd>
{%- endfor %}
      </dl>
    </aside>
    </div>

{%- for f in publication.figures %}

    <figure class="plate">
{%- if f.zoom %}
      <a class="zoom" href="{{ f.zoom|e }}" target="_blank" rel="noopener"
         aria-label="{{ f.zoom_label|e }}">
        <picture>
          <source type="image/webp" sizes="(max-width:760px) 92vw, (max-width:1180px) 84vw, 900px"
                  srcset="{{ f.srcset|e }}" />
          <img src="{{ f.fallback|e }}" width="{{ f.width|e }}" height="{{ f.height|e }}" loading="lazy" decoding="async"
               alt="{{ f.alt|e }}" />
        </picture>
        <span class="zoomtag">View full size</span>
      </a>
{%- else %}
      <picture>
        <source type="image/webp" sizes="(max-width:760px) 92vw, (max-width:1180px) 84vw, 900px"
                srcset="{{ f.srcset|e }}" />
        <img src="{{ f.fallback|e }}" width="{{ f.width|e }}" height="{{ f.height|e }}" loading="lazy" decoding="async"
             alt="{{ f.alt|e }}" />
      </picture>
{%- endif %}
      <figcaption><b>{{ f.caption_lead|e }}</b> {{ f.caption_html }}</figcaption>
    </figure>
{%- endfor %}
  </article>
</section>

<!-- ==================== RESEARCH ==================== -->
<section class="s wrap" id="research">
  <div class="shead reveal"><span class="n">{{ num('#research') }}</span><h2>{{ research.heading|e }}</h2></div>
{%- for it in research["items"] %}

  <article class="item reveal">
    <div>
      <h3>{{ it.title|e }}</h3>
      <div class="prose">
{%- for p in it.paragraphs_html %}
        <p>{{ p }}</p>
{%- endfor %}
      </div>
    </div>
    <div class="meta">
{%- if it.ongoing %}
      <span class="now">{{ it.ongoing_label or 'Ongoing'|e }}</span>
{%- endif %}
{%- for m in it["meta"] %}
      <span>{{ m|e }}</span>
{%- endfor %}
    </div>
  </article>
{%- endfor %}
</section>

<!-- ==================== PLACES / MAP ==================== -->
<section class="s wrap" id="places">
  <div class="shead reveal"><span class="n">{{ num('#places') }}</span><h2>{{ places.heading|e }}</h2></div>

  <div class="mapbox reveal">
    <svg class="map" viewBox="0 0 720 420" xmlns="http://www.w3.org/2000/svg"
         aria-label="{{ places.map_alt|e }}">
      <g class="grat">
        <line x1="0" y1="105" x2="720" y2="105"/><line x1="0" y1="210" x2="720" y2="210"/><line x1="0" y1="315" x2="720" y2="315"/>
        <line x1="180" y1="0" x2="180" y2="420"/><line x1="360" y1="0" x2="360" y2="420"/><line x1="540" y1="0" x2="540" y2="420"/>
      </g>
      <text class="axis" x="8" y="100">51&deg;N</text>
      <text class="axis" x="8" y="205">32&deg;N</text>
      <text class="axis" x="8" y="310">13&deg;N</text>

      <g class="compass" transform="translate(672,44)">
        <circle r="18"/><line x1="0" y1="12" x2="0" y2="-12"/>
        <text x="-4" y="-24">N</text>
      </g>

      <path class="move" d="{{ places.migration|e }}"/>

{%- for a in places.arcs %}
      <path class="arc" d="{{ a|e }}"/>
{%- endfor %}

      <circle class="trav t1" r="3"/>
      <circle class="trav t2" r="3"/>
      <circle class="trav t3" r="3"/>

{%- for n in places.nodes %}
      <g class="node{% if n.home %} home{% endif %}" data-blurb="{{ n.blurb|e }}">
        <circle class="c" cx="{{ n.x|e }}" cy="{{ n.y|e }}" r="5.5"/>
        <text x="{{ n.lx|e }}" y="{{ n.ly|e }}">{{ n.label|e }}</text>
      </g>
{%- endfor %}

      <text class="foot" x="14" y="406">{{ places.footnote|e }}</text>
    </svg>
  </div>
  <p class="mapcap reveal"><b>{{ places.caption_lead|e }}</b> <span id="mapread">{{ places.caption_idle|e }}</span></p>
</section>

<!-- ==================== OTHER WORK ==================== -->
<section class="s wrap" id="other">
  <div class="shead reveal"><span class="n">{{ num('#other') }}</span><h2>{{ other.heading|e }}</h2></div>
{%- for it in other["items"] %}

  <article class="item reveal">
    <div>
      <h3>{{ it.title|e }}</h3>
      <div class="prose">
{%- for p in it.paragraphs_html %}
        <p>{{ p }}</p>
{%- endfor %}
      </div>
    </div>
    <div class="meta">
{%- if it.ongoing %}
      <span class="now">{{ it.ongoing_label or 'Ongoing'|e }}</span>
{%- endif %}
{%- for m in it["meta"] %}
      <span>{{ m|e }}</span>
{%- endfor %}
    </div>
  </article>
{%- endfor %}
</section>

<!-- ==================== EDUCATION ==================== -->
<section class="s wrap" id="education">
  <div class="shead reveal"><span class="n">{{ num('#education') }}</span><h2>{{ education.heading|e }}</h2></div>

  <div class="twoup reveal">
{%- for e in education["items"] %}
    <div class="edu reveal">
      <div class="yr">{{ e.years|e }}</div>
      <h3>{{ e.institution|e }}</h3>
      <div class="deg">{{ e.degree|e }}</div>
      <p>{{ e.text_html }}</p>
    </div>
{%- endfor %}
  </div>

  <div class="kit reveal">
{%- for k in education.kit %}
    <div>
      <h4>{{ k.heading|e }}</h4>
      <p>{{ k.text_html }}</p>
    </div>
{%- endfor %}
  </div>
</section>

<!-- ==================== BEYOND ==================== -->
<section class="s wrap" id="beyond">
  <div class="shead reveal"><span class="n">{{ num('#beyond') }}</span><h2>{{ beyond.heading|e }}</h2></div>
  <ul class="beyond reveal">
{%- for b in beyond["items"] %}
    <li>
      <b>{{ b.title|e }}</b>
      <p>{{ b.text_html }}</p>
{%- if b.when %}
      <div class="when">{{ b.when|e }}</div>
{%- endif %}
    </li>
{%- endfor %}
  </ul>
</section>

</main>

<!-- ==================== CONTACT ==================== -->
<section id="contact">
  <div class="wrap inner">
    <p class="kicker">{{ contact.kicker|e }}</p>
    <h2>{{ contact.title|e }}</h2>
    <p>{{ contact.text_html }}</p>
    <a class="mailbig" href="mailto:{{ person.email|e }}">{{ person.email|e }}</a>
    <div class="cxlinks">
{%- for l in contact.links %}
      <a href="{{ l.href|e }}"{% if l.me %} rel="me noopener"{% endif %}>{{ l.label|e }}</a>
{%- endfor %}
    </div>
  </div>
</section>

<footer>
  <div class="wrap inner">
    <span>&copy; <span id="yr">2026</span> {{ person.name|e }}</span>
{%- if meta.footer_link_href %}
    <span><a class="altlink" href="{{ meta.footer_link_href|e }}">{{ meta.footer_link_label|e }} &rarr;</a></span>
{%- endif %}
    <span>Last updated {{ meta.last_updated|e }}</span>
  </div>
</footer>

<script>
{{ app_js }}
</script>
</body>
</html>
